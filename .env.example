# ---------------------------------------------------------------------------
# StudyMentor AI — environment variables
# Copy to .env and fill in only what you need. Never commit .env.
# All AI keys are server-side only and must not be prefixed with VITE_.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3001
# SQLite file used by the local prototype (created automatically)
DB_PATH=./data/studaymentor.db
# Seed sample content and the demo account on server start (off by default in production)
SEED_ON_START=true
# Set to false to skip creating the demo learner in shared/production environments
SEED_DEMO_ACCOUNT=true
# Public origin, used in docs/links. Not needed for local demo.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI provider (leave blank to run in clearly labelled demo mode)
# AI_PROVIDER: gemini | openai | demo
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_MODEL=
AI_TIMEOUT_MS=30000

# Google Gemini (AI_PROVIDER=gemini)
# Get a key from Google AI Studio. Use a server-only key with a spending limit.
GEMINI_API_KEY=

# OpenAI or any OpenAI-compatible chat-completions endpoint (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Supabase (optional — the local prototype does not use these yet)
# The SQL migration in supabase/migrations/0001_init.sql is ready for this path.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Vite (browser-visible). Only non-secret values belong here.
# ---------------------------------------------------------------------------
VITE_APP_NAME=StudyMentor AI
# Optional: change where the Vite dev server proxies /api
API_PROXY_TARGET=http://127.0.0.1:3001
